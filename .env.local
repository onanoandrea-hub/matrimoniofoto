NEXT_PUBLIC_API_BASE_URL=http://matrimonioandreafrancesca.duckdns.org

# Campo multipart = nome in multer (default files). Es: NEXT_PUBLIC_UPLOAD_FIELD=photos

# Stesso valore di TOKEN nel .env del Raspberry (NON committare il valore reale)
# In locale: copia in .env.local — Su Vercel: Environment Variables
# Stesso valore di TOKEN sul Pi (es. cambia-questo-token se usi quello lì)
UPLOAD_API_KEY=cambia-questo-token
