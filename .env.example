# --- Next.js (npm run dev / npm run start) → porta 3000 ---

# Su Vercel: URL pubblico del Pi. Sul Pi: opzionale (il proxy usa 127.0.0.1:UPLOAD_PORT)
NEXT_PUBLIC_API_BASE_URL=http://matrimonioandreafrancesca.duckdns.org

UPLOAD_API_KEY=cambia-questo-token

# --- Upload API (npm run start:upload) → porta UPLOAD_PORT ---

TOKEN=cambia-questo-token
UPLOAD_PORT=3001
UPLOAD_DIR=./uploads
MAX_FILES=50
# Per video iPhone usa almeno 100
MAX_FILE_MB=100

# Forza URL proxy (opzionale; default sul Pi: http://127.0.0.1:UPLOAD_PORT)
# UPLOAD_BACKEND_URL=http://127.0.0.1:3001
